# ---------------------------------------------------------------------------
# Copy to .env and fill in.  `make setup` does this for you.
# ---------------------------------------------------------------------------

# --- Claude (STAGE 2) ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max — how hard the model thinks per turn
AGENT_EFFORT=high
AGENT_MAX_TOKENS=32000
AGENT_MAX_ITERATIONS=24
# Show the model's reasoning summary while it works
AGENT_SHOW_THINKING=false

# --- AWS (STAGE 1/3) -------------------------------------------------------
AWS_REGION=us-east-1
# Leave empty to use the default credential chain (env vars, instance role, SSO)
AWS_PROFILE=
# Seconds before a single CLI call is abandoned
AGENT_CLI_TIMEOUT=90
# Seconds to reuse an identical read; 0 disables caching
AGENT_CACHE_TTL=60

# --- Safety (STAGE 7) ------------------------------------------------------
# ask   — prompt on the terminal before a sensitive read (default, interactive)
# deny  — refuse every sensitive read (use this for servers and CI)
# allow — auto-approve sensitive reads (break-glass only; loudly audited)
AGENT_APPROVAL_MODE=ask
# Mask 12-digit account ids in the audit log
AGENT_REDACT_ACCOUNT_ID=false
# Name recorded as the actor in the audit log
AGENT_ACTOR=

# --- State (STAGE 6/8) -----------------------------------------------------
AGENT_STATE_DIR=
AGENT_KNOWLEDGE_DIR=
AGENT_JSON_LOGS=false

# --- HTTP API (STAGE 4/8) --------------------------------------------------
# Required by `make serve` — generate one with: openssl rand -hex 32
AGENT_API_TOKEN=
